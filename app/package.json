{
  "name": "ideia-remote",
  "productName": "IDEIA Remote",
  "version": "0.2.0",
  "description": "Acesso remoto simples e gratuito com transferência de arquivos",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node test/e2e.js"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.0",
    "peerjs": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "peer": "^1.0.2"
  },
  "build": {
    "appId": "com.ideia.remote",
    "productName": "IDEIA Remote",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "IDEIA <luizferrazj-web@users.noreply.github.com>"
    },
    "publish": null,
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "afterPack": "build/after-pack.js",
    "artifactName": "IDEIA-Remote-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "artifactName": "IDEIA-Remote-Setup-${version}.${ext}"
    }
  },
  "author": "IDEIA <luizferrazj-web@users.noreply.github.com>",
  "homepage": "https://github.com/luizferrazj-web/REMOTEAPPCONNECT"
}
